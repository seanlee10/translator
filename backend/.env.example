# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required: Deepgram is the transcription itself (not a translation
# provider), so without it there is no source text at all.
DEEPGRAM_API_KEY=your-deepgram-key-here

# Optional: each translation-provider key below may be left unset — that is
# the default here, and copying this file as-is leaves all three unset. The
# UI only ever offers a model whose key is configured here — GET /providers
# advertises just the configured subset, and the server still starts (and
# still transcribes) with none of them set. Uncomment and fill in only the
# ones you want to enable.
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GROQ_API_KEY=your-groq-key-here
# XAI_API_KEY=your-xai-key-here

# Optional overrides — defaults shown.
# DEFAULT_PROVIDER=anthropic          # anthropic | groq | xai — falls back
#                                      # to the first configured provider
#                                      # (with a warning) if this key is unset
# ANTHROPIC_MODEL=claude-haiku-4-5
# GROQ_MODEL=qwen/qwen3.6-27b
# XAI_MODEL=grok-4.20-0309-non-reasoning
# XAI_BASE_URL=https://api.x.ai/v1
# DEEPGRAM_MODEL=nova-3
# TRANSLATE_INTERIMS=true
# DEBOUNCE_MS=400
# CONTEXT_PAIRS=3
# KOREAN_REGISTER=합니다체
# ENDPOINTING_MS=300
# UTTERANCE_END_MS=1000
