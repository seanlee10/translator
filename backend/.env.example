# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required: Deepgram is the transcription itself (not a translation
# provider), so without it there is no source text at all.
DEEPGRAM_API_KEY=your-deepgram-key-here

# Optional: each translation-provider key below may be left unset — that is
# the default here, and copying this file as-is leaves all three unset. The
# UI only ever offers a model whose key is configured here — GET /providers
# advertises just the configured subset, and the server still starts (and
# still transcribes) with none of them set. Uncomment and fill in only the
# ones you want to enable.
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GROQ_API_KEY=your-groq-key-here
# XAI_API_KEY=your-xai-key-here

# Optional: judge for scripts/benchmark_translation.py. Never used to serve
# translations and deliberately not in PROVIDER_REGISTRY — it exists so the
# benchmark can be scored from outside the compared set. A judge drawn from
# the three translation providers scores its own vendor's output, which is
# not an impartial ranking.
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_JUDGE_MODEL=gpt-5.5

# Optional: Arize AX tracing. Both of these must be set for tracing to turn
# on at all; either one alone (or a blank value) leaves it off and the server
# behaves exactly as it does here, with no exporter and no network calls.
#
# The space id is instance-scoped. A space that lives on app.arize.com (the
# US instance) does not exist on app.eu-west-1a.arize.com and vice versa —
# sending US credentials to the EU collector, or the reverse, drops every
# span silently. Take the id from the "Current SpaceID" field on the space's
# API Keys page and leave ARIZE_ENDPOINT unset unless you are on a non-US
# instance; the default collector is otlp.arize.com.
# ARIZE_SPACE_ID=your-space-id-here
# ARIZE_API_KEY=your-arize-key-here
# ARIZE_PROJECT_NAME=live-caption-translator
# ARIZE_ENDPOINT=                     # blank = arize-otel's default (US)

# Optional overrides — defaults shown.
# DEFAULT_PROVIDER=anthropic          # anthropic | groq | xai — falls back
#                                      # to the first configured provider
#                                      # (with a warning) if this key is unset
# ANTHROPIC_MODEL=claude-haiku-4-5
# GROQ_MODEL=qwen/qwen3.6-27b
# XAI_MODEL=grok-4.20-0309-non-reasoning
# XAI_BASE_URL=https://api.x.ai/v1
# DEEPGRAM_MODEL=nova-3
# TRANSLATE_INTERIMS=false
# DEBOUNCE_MS=400
# CONTEXT_PAIRS=3
# KOREAN_REGISTER=합니다체
# ENDPOINTING_MS=300
# UTTERANCE_END_MS=1000
